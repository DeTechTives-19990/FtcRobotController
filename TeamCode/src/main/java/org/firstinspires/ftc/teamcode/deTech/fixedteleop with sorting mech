package org.firstinspires.ftc.teamcode;

import com.qualcomm.hardware.gobilda.GoBildaPinpointDriver;
import com.qualcomm.hardware.rev.RevHubOrientationOnRobot;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.IMU;
import com.qualcomm.robotcore.hardware.Servo;
import com.qualcomm.robotcore.hardware.VoltageSensor;
import com.qualcomm.robotcore.util.ElapsedTime;

import org.firstinspires.ftc.robotcore.external.navigation.AngleUnit;
import org.firstinspires.ftc.robotcore.external.navigation.DistanceUnit;
import org.firstinspires.ftc.robotcore.external.navigation.Pose2D;

@TeleOp(name = "Complete TeleOp", group = "Competition")
public class completeTeleOp extends OpMode {

    // ==================== HARDWARE ====================
    private DcMotorEx rightFront, leftFront, rightBack, leftBack;

    private DcMotorEx shooterOne, shooterTwo;

    private DcMotorEx turretMotor;
    private DcMotorEx intakeMotor;

    private Servo kickerServo;    // servKick
    private Servo indexerServo;   // servSpin
    private Servo hoodServo;      // hood

    private GoBildaPinpointDriver odometry; // odo
    private VoltageSensor voltageSensor;
    private IMU imu; // odoi

    // ==================== CONSTANTS ====================
    private static final double[] INDEXER_POSITIONS = {0.686, 0.6125, 0.53};
    private static final double[] KICKER_POSITIONS = {0.66, 0.275};  // [0]=down, [1]=up

    // Shooter
    private static final double SHOOTER_RPM = 6000.0;
    private static final double TICKS_PER_MOTOR_REV = 28.0;
    private static final double SHOOTER_VELOCITY = SHOOTER_RPM * TICKS_PER_MOTOR_REV / 60.0;  // 1300
    private static final int[] SHOOTER_VELOCITIES = {
        1000,  // 1
        1050,  // 2
        1100,  // 3
        1200,  // 4
        1250,  // 5
        1300,  // 6
        1300,  // 7
        1300,  // 8
        1300,  // 9
        1300,  // 10
        2000,  // 11
        2050,  // 12
        2100,  // 13
        2200,  // 14
        2300,  // 15
        2300,  // 16
        2300   // 17
    };
    private static final double[] HOOD_POSITIONS = {
        .601,  // 1
        .601,  // 2
        .601,  // 3
        .601,  // 4
        .601,  // 5
        .601,  // 6
        .601,  // 7
        .601,  // 8
        .601,  // 9
        .601,  // 10
        .601,  // 11
        .601,  // 12
        .601,  // 13
        .601,  // 14
        .601,  // 15
        .601,  // 16
        .601   // 17
    };
    private static final double SHOOTER_CORRECTION_FACTOR = 7.5;

    // Hood
    private static final double HOOD_CLOSE = 0.3;
    private static final double HOOD_FAR = 0.7;
    private static final double HOOD_DEFAULT = 0.5;

    private static final double CLOSE_DISTANCE = 48.0;
    private static final double FAR_DISTANCE = 96.0;

    // Turret encoder config (EXACT FROM YOUR turretTracking)
    private static final double TICKS_PER_REV = 384.5;
    private static final double GEAR_RATIO = 5.0;
    private static final double TICKS_PER_TURRET_REV = TICKS_PER_REV * GEAR_RATIO; // 1922.5 ticks = 360°

    // Safe range EXACTLY 360° (EXACT FROM YOUR turretTracking)
    private static final int MIN_TURRET_TICKS = -353;
    private static final int MAX_TURRET_TICKS = 1569;

    // Target position (basket)
    private static final double TARGET_X = 0.0;
    private static final double TARGET_Y = 144.0;

    // Starting position
    private static final double START_X = 24.0;
    private static final double START_Y = 105.0;
    private static final double START_HEADING = Math.atan2(144 - 114, 0 - 29); // EXACT

    // ==================== STATE ====================
    private final ElapsedTime runtime = new ElapsedTime();
    private final ElapsedTime shootSequenceTimer = new ElapsedTime();

    private double lastTime = 0;
    private double fps = 0;

    private double drivePower = 1.0;

    private int kickerState = 0;      // 0=down, 1=up
    private int indexerState = 1;     // 0,1,2
    private int shooterRange = 0;     // 0-17 feet

    private final double[] shooterEncoderHistory = {0.0, 0.0, 0.0}; // [curr, prev, vel]

    private boolean isShootingSequence = false;

    // IMPORTANT: start OFF so it doesn't move in INIT (matches LinearOpMode behavior)
    private boolean turretAutoAim = false;

    // Gate to prevent any turretTracking logic before START
    private boolean hasStarted = false;
    
    // Give more controls
    double hoodLevel = .3;
    int rpmMod = 0;

    private boolean lastX = false;
    private boolean lastY = false;
    private boolean lastGuide = false;

    // ==================== INIT ====================
    @Override
    public void init() {
        initDriveMotors();
        initShooterMotors();
        initTurretMotor();
        initIntakeMotor();
        initServos();
        initSensors();

        telemetry.addLine("Initialized");
        telemetry.addLine("Y = toggle turret auto-aim (OFF at start)");
        telemetry.update();
    }

    // Called once when driver presses PLAY (this is how we mimic LinearOpMode)
    @Override
    public void start() {
        hasStarted = true;

        // Latch buttons so holding Y/X in init doesn't trigger instantly
        lastY = gamepad2.y;
        lastX = gamepad2.x;
        lastGuide = gamepad1.guide;

        // EXACT turretTracking behavior: set pose again at start
        odometry.setPosition(new Pose2D(DistanceUnit.INCH, START_X, START_Y, AngleUnit.RADIANS, START_HEADING));

        // Ensure turret isn't accidentally in RUN_TO_POSITION from init phase
        turretMotor.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        turretMotor.setPower(0);

        runtime.reset();
        shootSequenceTimer.reset();
        lastTime = runtime.seconds();

        // Ensure it stays OFF unless you toggle it ON
        turretAutoAim = false;
    }

    private void initDriveMotors() {
        rightFront = hardwareMap.get(DcMotorEx.class, "rightForw");
        leftFront  = hardwareMap.get(DcMotorEx.class, "leftForw");
        rightBack  = hardwareMap.get(DcMotorEx.class, "rightBack");
        leftBack   = hardwareMap.get(DcMotorEx.class, "leftBack");

        rightFront.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        leftFront.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        rightBack.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        leftBack.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        // Standard: reverse right side for forward stick = forward motion
        rightFront.setDirection(DcMotor.Direction.REVERSE);
        rightBack.setDirection(DcMotor.Direction.REVERSE);
        leftFront.setDirection(DcMotor.Direction.FORWARD);
        leftBack.setDirection(DcMotor.Direction.FORWARD);
    }

    private void initShooterMotors() {
        shooterOne = hardwareMap.get(DcMotorEx.class, "shooterone");
        shooterTwo = hardwareMap.get(DcMotorEx.class, "shootertwo");

        shooterOne.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        shooterTwo.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);

        shooterOne.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        shooterTwo.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);

        shooterOne.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        shooterTwo.setMode(DcMotor.RunMode.RUN_USING_ENCODER);

        // Both CCW as you asked (same direction)
        shooterOne.setDirection(DcMotor.Direction.REVERSE);
        shooterTwo.setDirection(DcMotor.Direction.REVERSE);
    }

    private void initTurretMotor() {
        turretMotor = hardwareMap.get(DcMotorEx.class, "turret");
        turretMotor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        turretMotor.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        turretMotor.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
    }

    private void initIntakeMotor() {
        intakeMotor = hardwareMap.get(DcMotorEx.class, "intake");
        intakeMotor.setDirection(DcMotor.Direction.REVERSE);
    }

    private void initServos() {
        kickerServo  = hardwareMap.get(Servo.class, "servKick");
        indexerServo = hardwareMap.get(Servo.class, "servSpin");
        hoodServo    = hardwareMap.get(Servo.class, "hood");

        kickerServo.setPosition(KICKER_POSITIONS[0]);
        indexerServo.setPosition(INDEXER_POSITIONS[1]);
        hoodServo.setPosition(HOOD_DEFAULT);
    }

    private void initSensors() {
        odometry = hardwareMap.get(GoBildaPinpointDriver.class, "odo");
        odometry.setOffsets(8.5, 1.75, DistanceUnit.INCH);
        odometry.setEncoderDirections(
                GoBildaPinpointDriver.EncoderDirection.REVERSED,
                GoBildaPinpointDriver.EncoderDirection.REVERSED
        );
        odometry.setEncoderResolution(GoBildaPinpointDriver.GoBildaOdometryPods.goBILDA_4_BAR_POD);
        odometry.resetPosAndIMU();

        odometry.setPosition(new Pose2D(DistanceUnit.INCH, START_X, START_Y, AngleUnit.RADIANS, START_HEADING));

        voltageSensor = hardwareMap.voltageSensor.iterator().next();

        imu = hardwareMap.get(IMU.class, "imu");
        IMU.Parameters imuParams = new IMU.Parameters(
                new RevHubOrientationOnRobot(
                        RevHubOrientationOnRobot.LogoFacingDirection.UP,
                        RevHubOrientationOnRobot.UsbFacingDirection.RIGHT
                )
        );
        imu.initialize(imuParams);
        imu.resetYaw();
    }

    // ==================== LOOP ====================
    @Override
    public void loop() {
        double currentTime = runtime.seconds();
        double delta = currentTime - lastTime;
        fps = (delta > 0) ? 1.0 / delta : 0;
        lastTime = currentTime;

        odometry.update();
        updateShooterVelocity();

        handleDriveInput();
        handleDrivePowerAdjustment();
        handleIntakeInput();
        handleShooterInput();
        handleKickSequence();

        // ONLY aim turret after START and only if toggled ON
        handleTurretAim();

        handleHoodAdjustment();
        handleMiscInput();

        updateServos();
        updateTelemetry();
    }

    // ==================== DRIVE ====================
    private void handleDriveInput() {
        double y = -gamepad1.left_stick_y;
        double x = gamepad1.left_stick_x;
        double rx = gamepad1.right_stick_x;

        double voltageComp = Math.max(1.0, voltageSensor.getVoltage() / 12.0);
        double denom = Math.max(Math.abs(y) + Math.abs(x) + Math.abs(rx), 1.0);

        double lf = (y + x + rx) / denom / voltageComp * drivePower;
        double lb = (y - x + rx) / denom / voltageComp * drivePower;
        double rf = (y - x - rx) / denom / voltageComp * drivePower;
        double rb = (y + x - rx) / denom / voltageComp * drivePower;

        leftFront.setPower(-lf);
        leftBack.setPower(-lb);
        rightFront.setPower(-rf);
        rightBack.setPower(-rb);
    }

    private void handleDrivePowerAdjustment() {
        if (gamepad1.dpad_up) drivePower = 1.0;
        if (gamepad1.dpad_right) drivePower = 0.75;
        if (gamepad1.dpad_down) drivePower = 0.5;
        if (gamepad1.dpad_left) drivePower = 0.25;
    }

    // ==================== INTAKE ====================
    private void handleIntakeInput() {
        boolean intakeIn  = gamepad1.right_bumper;
        boolean intakeOut = gamepad1.left_bumper;
    
        if (intakeIn) {
            intakeMotor.setPower(-1.0);
            // while intaking, hold indexer at FEED position (pick whichever works)
            indexerState = 0; // or 2 depending on your mechanism
        } 
        else if (intakeOut) {
        intakeMotor.setPower(1.0);
            indexerState = 1;
        }
        else{
        intakeMotor.setPower(0.0);
        if(!isShootingSequence){
            indexerState = 1;
            }
        }
    }

    // ==================== SHOOTER ====================
    private void updateShooterVelocity() {
        shooterEncoderHistory[1] = shooterEncoderHistory[0];
        shooterEncoderHistory[0] = shooterOne.getCurrentPosition();
        shooterEncoderHistory[2] = (shooterEncoderHistory[0] - shooterEncoderHistory[1]) * fps;
    }
    
    private int targetRange() {
        Pose2D pose = odometry.getPosition();
        double robotX = pose.getX(DistanceUnit.INCH);
        double robotY = pose.getY(DistanceUnit.INCH);
        
        double distance = Math.hypot(0 - robotX, 56 - robotY);
        distance /= 12;  // Convert to in
        int range = (int) Math.round(distance);
        
        if (range > 17) return 16;
        
        return range - 1;
    }

    private boolean isShooterReady() {
        double target = SHOOTER_VELOCITIES[shooterRange];
        double current = shooterEncoderHistory[2];
        return Math.abs(current - target) <= SHOOTER_CORRECTION_FACTOR;
    }

    private void handleShooterInput() {
        if (gamepad2.a) shooterRange = targetRange();
        if (gamepad2.b) shooterRange = targetRange();
        
        if (gamepad2.dpad_up) rpmMod += 1;
        if (gamepad2.dpad_down) rpmMod -= 1;

        if (gamepad2.a || gamepad2.b) {
            double targetVelocity = SHOOTER_VELOCITIES[shooterRange];
            shooterOne.setVelocity(targetVelocity);
            shooterTwo.setVelocity(targetVelocity);
        } else {
            shooterOne.setVelocity(0);
            shooterTwo.setVelocity(0);
        }
    }

    // ==================== KICKER/INDEXER (UNCHANGED LADDER) ====================
    private void handleKickSequence() {
        boolean xPressed = gamepad2.x && !lastX;
        lastX = gamepad2.x;

        if (xPressed && !isShootingSequence) {
            isShootingSequence = true;
            shootSequenceTimer.reset();
        }

        if (isShootingSequence) {
            double elapsed = shootSequenceTimer.seconds();
            
            if (elapsed > 2.75) {
                isShootingSequence = false;
                kickerState = 0;
                indexerState = 1;
            }
            // } else if (elapsed > 2.5) {
            //     indexerState = 2;
             else if (elapsed > 2.55) {
                kickerState = 0;
            } else if (elapsed > 2.3) {
                kickerState = 1;
            } else if (elapsed > 1.5) {
                indexerState = 2;
            } else if (elapsed > 1.25) {
                kickerState = 0;
            } else if (elapsed > 1.0) {
                kickerState = 1;
            } else if (elapsed > 0.5) {
                indexerState = 0;
            } else if (elapsed > 0.25) {
                kickerState = 0;
            } else if (elapsed >= 0.0) {
                kickerState = 1;
            }
        }
    }

    // ==================== TURRET (EXACT turretTracking LOGIC, GATED) ====================
    private void handleTurretAim() {
        // Toggle auto-aim with Y button (edge detection)
        boolean yPressed = gamepad2.y && !lastY;
        lastY = gamepad2.y;
        if (yPressed) {
            turretAutoAim = !turretAutoAim;

            if (!turretAutoAim) {
                turretMotor.setPower(0);
                turretMotor.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
            }
        }

        // Do not run auto aim before start, and do not run if turned off
        if (!hasStarted) return;

        if (!turretAutoAim) {
            double power = 0;
    
            if (gamepad2.right_trigger > 0.1) {
                power = 0.4*gamepad2.right_trigger;
            } else if (gamepad2.left_trigger > 0.1) {
                power = -0.4*gamepad2.left_trigger;
            }
    
            turretMotor.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
            turretMotor.setPower(power);
            return; // IMPORTANT: don't run auto aim
        }

        // === AUTO TURRET TRACKING (EXACT FROM turretTracking) ===
        Pose2D pose = odometry.getPosition();

        double robotX = pose.getX(DistanceUnit.INCH);
        double robotY = pose.getY(DistanceUnit.INCH);
        double headingRad = pose.getHeading(AngleUnit.RADIANS);

        // Convert heading to 0-360 range
        double headingDeg = Math.toDegrees(headingRad);

        double odoTarget = Math.atan2(TARGET_Y - robotY, TARGET_X - robotX);
        double odoTargetDeg = Math.toDegrees(odoTarget);

        // Both are now 0-360, subtraction gives -360 to +360
        double targetDeg = odoTargetDeg - headingDeg;
        
        telemetry.addData("haeding", headingDeg);
        telemetry.addData("turret", odoTargetDeg);
        telemetry.addData("targetDge", targetDeg);
        telemetry.addData("turretmotor", turretMotor.getCurrentPosition());


        // Convert to ticks
        int targetTicks = (int) (targetDeg / 3600 * TICKS_PER_TURRET_REV);

        // Flip for motor direction
        targetTicks = -targetTicks;

        // Wrap to safe range (exactly 360°)
        while (targetTicks < MIN_TURRET_TICKS) {
            targetTicks += (int) TICKS_PER_TURRET_REV;
        }
        while (targetTicks > MAX_TURRET_TICKS) {
            targetTicks -= (int) TICKS_PER_TURRET_REV;
        }

        turretMotor.setTargetPosition(targetTicks);
        turretMotor.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        turretMotor.setPower(1.0);
    }

    // ==================== HOOD ====================
    private void handleHoodAdjustment() {
        Pose2D pose = odometry.getPosition();
        double robotX = pose.getX(DistanceUnit.INCH);
        double robotY = pose.getY(DistanceUnit.INCH);

        double distance = Math.hypot(TARGET_X - robotX, TARGET_Y - robotY);

        double hoodPosition = HOOD_POSITIONS[targetRange()];
        if (distance < CLOSE_DISTANCE) {
            hoodPosition = HOOD_CLOSE;
        } else if (distance > FAR_DISTANCE) {
            hoodPosition = HOOD_FAR;
        } else {
            double t = (distance - CLOSE_DISTANCE) / (FAR_DISTANCE - CLOSE_DISTANCE);
            hoodPosition = HOOD_CLOSE + t * (HOOD_FAR - HOOD_CLOSE);
        }
        hoodServo.setPosition(hoodPosition);
    }

    // ==================== MISC ====================
    private void handleMiscInput() {
        boolean guidePressed = gamepad1.guide && !lastGuide;
        lastGuide = gamepad1.guide;

        if (guidePressed) {
            imu.resetYaw();
            odometry.setPosition(new Pose2D(DistanceUnit.INCH, START_X, START_Y, AngleUnit.RADIANS, START_HEADING));
        }
    }

    private void updateServos() {
        kickerServo.setPosition(KICKER_POSITIONS[kickerState]);
        indexerServo.setPosition(INDEXER_POSITIONS[indexerState]);
    }

    private void updateTelemetry() {
        Pose2D pose = odometry.getPosition();
        double distance = Math.hypot(TARGET_X - pose.getX(DistanceUnit.INCH), TARGET_Y - pose.getY(DistanceUnit.INCH));

        telemetry.addData("FPS", "%.0f", fps);
        telemetry.addData("Drive", "%.0f%%", drivePower * 100);

        telemetry.addData("Pos", "(%.1f, %.1f)",
        pose.getX(DistanceUnit.INCH), pose.getY(DistanceUnit.INCH));
        telemetry.addData("Heading(not rad)", "%.2f", pose.getHeading(AngleUnit.DEGREES));

        telemetry.addData("Dist", "%.1f", distance);
        telemetry.addData("Turret Auto", turretAutoAim ? "ON" : "OFF");
        telemetry.addData("Turret Ticks", "%d", turretMotor.getCurrentPosition());

        telemetry.addData("Shooter Range", shooterRange);
        telemetry.addData("Shooter vel", SHOOTER_VELOCITIES[shooterRange]);
        telemetry.addData("Ready", isShooterReady() ? "YES" : "NO");

        telemetry.addData("Seq", isShootingSequence ? "ACTIVE" : "idle");
        telemetry.addData("Kicker", kickerState);
        telemetry.addData("Indexer", indexerState);
        telemetry.addData("RT", gamepad1.right_trigger);
        telemetry.addData("LT", gamepad1.left_trigger);


        telemetry.update();
    }

    @Override
    public void stop() {
        rightFront.setPower(0);
        leftFront.setPower(0);
        rightBack.setPower(0);
        leftBack.setPower(0);

        shooterOne.setVelocity(0);
        shooterTwo.setVelocity(0);

        turretMotor.setPower(0);
        turretMotor.setMode(DcMotor.RunMode.RUN_USING_ENCODER);

        intakeMotor.setPower(0);
    }
}

